service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'aburayhan10x@gmail.com';
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: everyone can read, only admins and the user can write
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    // Everything else: only admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
