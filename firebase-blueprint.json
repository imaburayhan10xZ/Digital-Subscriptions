{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Product": {
      "title": "Product",
      "description": "Products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User documents"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Product documents"
    }
  }
}
